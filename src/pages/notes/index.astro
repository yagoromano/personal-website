---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const notes = (await getCollection("notes")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Notes · Yago Romano"
  description="Short write-ups on things I build and learn, covering AI engineering, machine learning, and software."
>
  <Nav />
  <main class="container notes-page">
    <h1>Notes</h1>
    <p class="intro">Short write-ups on things I build and learn.</p>
    <ul class="notes-list">
      {notes.map((entry) => (
        <li class="notes-item">
          <a href={`/notes/${entry.id}/`} class="notes-title">{entry.data.title}</a>
          <p class="notes-date">
            {entry.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
          </p>
          <p class="notes-description">{entry.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notes-page {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
    max-width: 720px;
  }

  h1 {
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
  }

  .intro {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }

  .notes-title {
    color: var(--text);
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-decoration: none;
  }

  .notes-title:hover {
    text-decoration: underline;
  }

  .notes-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: var(--space-1);
  }

  .notes-description {
    color: var(--text-muted);
    margin-top: var(--space-2);
  }
</style>
