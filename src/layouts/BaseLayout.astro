---
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/space-grotesk/600.css";
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  /** Error pages have no real URL of their own, so they skip canonical/og:url and ask not to be indexed. */
  noindex?: boolean;
}

const { title, description = SITE.description, ogType = "website", noindex = false } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const canonical = noindex ? undefined : new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      let theme = 'dark';
      try {
        theme = localStorage.getItem('theme') ?? 'dark';
      } catch {
        theme = 'dark';
      }
      document.documentElement.dataset.theme = theme;
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Yago Romano Martinez" />
    <meta name="theme-color" content="#0f1115" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.tagline}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>
