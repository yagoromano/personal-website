---
import { ExternalLink } from "lucide-astro";
import { PUBLICATIONS, AUTHOR_NAME } from "../data/publications";
---

<section id="research" class="research-section">
  <div class="container">
    <h2>Research</h2>
    <p class="section-intro">Peer-reviewed papers across LLM agents, autonomous vehicle perception, and robotics security. Each one links to the project it came from.</p>
    <ul class="research-list">
      {PUBLICATIONS.map((pub) => (
        <li class="research-row">
          <div class="research-meta">
            <span class="research-venue">{pub.venueShort}</span>
            <span class="research-role">{pub.contribution}</span>
          </div>
          <div class="research-main">
            {pub.projectSlug ? (
              <h3><a href={`/projects/${pub.projectSlug}/`} class="research-title-link">{pub.title}</a></h3>
            ) : (
              <h3>{pub.title}</h3>
            )}
            <p class="research-authors">
              {pub.authors.map((author, i) => (
                <>
                  {i > 0 && ", "}
                  {author === AUTHOR_NAME ? <strong>{author}</strong> : author}
                </>
              ))}
            </p>
          </div>
          <a href={pub.arxivUrl} target="_blank" rel="noopener noreferrer" class="research-link">
            <ExternalLink size={14} />
            arXiv
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .section-intro {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .research-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .research-row {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }

  .research-meta {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .research-venue {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.82rem;
    color: var(--accent);
  }

  .research-role {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .research-main {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .research-main h3 {
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .research-title-link {
    color: inherit;
    text-decoration: none;
  }

  .research-title-link:hover {
    text-decoration: underline;
  }

  .research-authors {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .research-authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .research-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .research-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .research-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .research-meta {
      flex-direction: row;
      gap: var(--space-3);
    }
  }
</style>
