---
import { ExternalLink, ArrowRight } from "lucide-astro";
import { PUBLICATIONS, AUTHOR_NAME } from "../data/publications";
---

<section id="publications" class="publications-section">
  <div class="container">
    <h2>Publications</h2>
    <p class="section-intro">Peer-reviewed research across LLM agents, autonomous vehicle perception, and robotics security.</p>
    <ul class="pub-list">
      {PUBLICATIONS.map((pub) => (
        <li class="pub-item">
          <div class="pub-head">
            <h3 class="pub-title">{pub.title}</h3>
            <span class="pub-contribution">{pub.contribution}</span>
          </div>
          <p class="pub-venue">{pub.venue} {pub.year}</p>
          <p class="pub-authors">
            {pub.authors.map((author, i) => (
              <>
                {i > 0 && ", "}
                {author === AUTHOR_NAME ? <strong>{author}</strong> : author}
              </>
            ))}
          </p>
          <p class="pub-summary">{pub.summary}</p>
          <div class="pub-links">
            <a href={pub.arxivUrl} target="_blank" rel="noopener noreferrer" class="pub-link">
              <ExternalLink size={15} />
              View on arXiv
            </a>
            {pub.projectSlug && (
              <a href={`/projects/${pub.projectSlug}/`} class="pub-link">
                <ArrowRight size={15} />
                Read project
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 {
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .section-intro {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }

  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .pub-item {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: var(--space-4);
  }

  .pub-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .pub-title {
    flex: 1;
    min-width: 0;
    font-size: 1.1rem;
    font-family: var(--font-display);
    line-height: 1.3;
  }

  .pub-contribution {
    flex-shrink: 0;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .pub-venue {
    color: var(--text);
    font-size: 0.9rem;
    margin-top: var(--space-2);
  }

  .pub-authors {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-top: var(--space-1);
  }

  .pub-authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .pub-summary {
    color: var(--text-muted);
    margin-top: var(--space-3);
    line-height: 1.6;
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .pub-link:hover {
    text-decoration: underline;
  }
</style>
