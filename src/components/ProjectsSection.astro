---
import ProjectCard from "./ProjectCard.astro";
import ProjectCardCompact from "./ProjectCardCompact.astro";
import { getCollection } from "astro:content";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const compact = all.filter((p) => !p.data.featured);
---

<section id="projects" class="projects-section">
  <div class="container">
    <h2>Projects</h2>
    <p class="section-intro">Systems I have built, most significant first. Each one has a write-up covering how it works.</p>

    <div class="project-featured-grid">
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>

    {compact.length > 0 && (
      <div class="project-compact-grid">
        {compact.map((project) => <ProjectCardCompact project={project} />)}
      </div>
    )}
  </div>
</section>

<style>
  h2 {
    font-size: 2rem;
    margin-bottom: var(--space-2);
  }

  .section-intro {
    color: var(--text-muted);
    margin-bottom: var(--space-5);
  }
</style>
