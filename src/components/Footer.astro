---
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <p>&copy; {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--space-4) 0;
  }

  p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
</style>
